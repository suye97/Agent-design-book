# ============ Embedding（DashScope / OpenAI 兼容） ============
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=10
# 无 key 时置 1，用确定性桩向量跑通链路（仅开发调试，检索语义无效）
EMBEDDING_MOCK=0

# ============ Milvus ============
SYMBOL_AGENT_MILVUS_URI=http://<MILVUS_HOST>:19530
SYMBOL_AGENT_MILVUS_TOKEN=<MILVUS_TOKEN>
MILVUS_COLLECTION=agent_design_kb

# ============ 后台入库接口 ============
# 留空则关闭 /api/admin/ingest；设置后使用 Authorization: Bearer <key>
ADMIN_API_KEY=

# ============ LLM（意图路由 + 答案生成；OpenAI 兼容） ============
# DeepSeek: https://api.deepseek.com  deepseek-chat
# 阿里百炼: https://dashscope.aliyuncs.com/compatible-mode/v1  qwen-plus
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ============ 检索/路由 ============
RAG_TOP_K=8
